{
  "name": "pi-signal-board",
  "version": "0.1.0",
  "description": "Persistent updates and asynchronous decision inbox for the Pi coding agent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "check": "biome check . && tsc -p tsconfig.json --noEmit",
    "format": "biome check --write .",
    "test": "vitest run tests --exclude tests/performance/replay.test.ts && vitest run tests/performance/replay.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "pack:check": "node ./scripts/pack-check.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "terminal",
    "tui",
    "agent"
  ],
  "license": "MIT",
  "author": "Agent Board contributors",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.9",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
